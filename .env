# Database
DATABASE_URL=sqlite:///./vault.db

# Encryption (AES-256 GCM 32-byte key)
VAULT_KEY=smartvault-aes256-secret-key-32b!

# Auth / JWT
JWT_SECRET=smartvault-jwt-super-secret-key-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Configuration (Gemini)
AI_MOCK=true
GEMINI_API_KEY=mock-gemini-key
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30

# Emergency Access (seconds before nominee unlock, 60s for demo)
ACCESS_WAIT_SECONDS=60

# Storage
STORAGE_PATH=./storage
TEMP_PATH=./storage/temp

# Feature Flags
ENABLE_RESEND_EMAIL=false
RESEND_API_KEY=
